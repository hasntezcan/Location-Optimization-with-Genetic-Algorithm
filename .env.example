# Optional absolute path to the repository root.
# Leave blank for the current local layout.
PROJECT_ROOT=

# Optional absolute path to the Next.js UI directory.
# Leave blank for the current local layout.
UI_ROOT=

# Paths may be absolute or relative to PROJECT_ROOT.
GA_CANDIDATE_CSV=data/candidate_points.csv
GA_DISTANCE_MATRIX=data/kadikoy_distance_meters_nxn.npy
GA_OUTPUT_DIR=output
UI_MOCK_DIR=parcel-locker-ui/public/mock

# Optional executable overrides. Leave blank to use OS-specific defaults.
MAVEN_CMD=
PYTHON_CMD=

# Timeout for the Java GA process launched by /api/run-ga.
GA_MAX_RUNTIME_MS=900000
